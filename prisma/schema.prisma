// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  username        String?          @unique
  password        String?
  name            String?
  isActive        Boolean          @default(false)
  accountType     AccountType      @default(LOCAL)
  userType        UserType         @default(CUSTOMER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  roleId          Int?
  role            Role?            @relation(fields: [roleId], references: [id])
  customerProfile CustomerProfile?

  @@map("users")
}

enum AccountType {
  LOCAL
  GOOGLE
  GITHUB
}

enum UserType {
  ADMIN
  STAFF
  CUSTOMER
}

model Role {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  permissions Json?
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  @@map("roles")
  users User[]
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  resource   String
  resourceId String?
  statusCode Int?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  products    Product[]

  @@map("categories")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  price       Decimal       @db.Decimal(10, 2)
  stock       Int           @default(0)
  status      ProductStatus @default(ACTIVE)
  images      String[]
  categoryId  Int
  category    Category      @relation(fields: [categoryId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  @@map("products")
}

model CustomerProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  fullName  String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("customer_profiles")
}