// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int         @id @default(autoincrement())
  email       String      @unique
  username    String?     @unique
  password    String?
  name        String?
  isActive    Boolean     @default(false)
  accountType AccountType @default(LOCAL)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  roleId      Int
  role        Role       @relation(fields: [roleId], references: [id])

  @@map("users")
}

enum AccountType {
  LOCAL
  GOOGLE
  GITHUB
}

model Role {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  permissions Json?
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  @@map("roles")
  users User[]
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  resource   String
  resourceId String?
  statusCode Int?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}